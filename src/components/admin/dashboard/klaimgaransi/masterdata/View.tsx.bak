"use client";

import { useEffect, useState } from "react";
import { CiSearch } from "react-icons/ci";
import { FiDownload } from "react-icons/fi";
import { MdOutlineRemoveRedEye } from "react-icons/md";
import { IoCalendarOutline, IoDocumentTextOutline } from "react-icons/io5";
import { BsCheckCircle, BsFileText } from "react-icons/bs";
import Link from "next/link";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import { getMasterDataIndex, getMasterDataStats } from "@/services/admin/MasterData";
import Pagination from "@/components/ui/Pagination";
import { showSuccessToast } from "@/helper/toastHelper";

interface ClaimWarrantyData {
  id: number;
  claim_submission_code: string;
  warranty_code: string;
  name: string;
  plate_number: string;
  odometer: number;
  status: string;
  status_label: string;
}

interface StatsData {
  total_last_30_days: number;
  total_last_30_days_percentage: number;
  pending_verification: number;
  pending_verification_percentage: number;
  completed: number;
  completed_percentage: number;
  received: number;
}

export default function MasterDataView() {
  const [data, setData] = useState<ClaimWarrantyData[]>([]);
  const [stats, setStats] = useState<StatsData | null>(null);
  const [loading, setLoading] = useState(false);
  const [page, setPage] = useState(1);
  const [searchInput, setSearchInput] = useState("");
  const [search, setSearch] = useState("");
  const [perPage, setPerPage] = useState<10 | 20 | 30>(10);
  const [totalPages, setTotalPages] = useState(1);
  const [pagination, setPagination] = useState<any>(null);
  const [selectedIds, setSelectedIds] = useState<number[]>([]);
  const [selectAll, setSelectAll] = useState(false);
  const [timeFilter, setTimeFilter] = useState("30 Hari Terakhir");

  useEffect(() => {
    const fetchStats = async () => {
      try {
        const res = await getMasterDataStats();
        if (res?.success && res.data) {
          setStats(res.data);
        }
      } catch (error) {
        console.error(error);
      }
    };

    fetchStats();
  }, []);

  useEffect(() => {
    const fetchData = async () => {
      setLoading(true);
      try {
        const res = await getMasterDataIndex(page, perPage, search, "");
        
        if (res?.success && res.data) {
          setPagination(res.data);
          setData(res.data.data ?? []);
          setTotalPages(res.data.last_page ?? 1);
        }
      } catch (error) {
        console.error(error);
        setData([]);
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, [page, search, perPage]);

  const getPagination = (
    current: number,
    total: number
  ): (number | "...")[] => {
    const pages: (number | "...")[] = [];

    if (total <= 3) {
      for (let i = 1; i <= total; i++) pages.push(i);
      return pages;
    }

    pages.push(1);

    if (current > 3) {
      pages.push("...");
    }

    const start = Math.max(2, current - 1);
    const end = Math.min(total - 1, current + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (current < total - 2) {
      pages.push("...");
    }

    pages.push(total);

    return pages;
  };

  const handleExport = () => {
    try {
      setLoading(true);

      const basePath = process.env.NEXT_PUBLIC_BASE_PATH ?? "";
      const exportUrl = `${basePath}/api/claim-warranty/principal/export`;
      
      window.location.href = exportUrl;

      showSuccessToast(
        "Export Started",
        "File sedang diproses dan akan terunduh otomatis"
      );
    } catch (error) {
      console.error(error);
    } finally {
      setTimeout(() => {
        setLoading(false);
      }, 1000);
    }
  };

  const handleSelectAll = () => {
    if (selectAll) {
      setSelectedIds([]);
    } else {
      setSelectedIds(data.map(item => item.id));
    }
    setSelectAll(!selectAll);
  };

  const handleSelectItem = (id: number) => {
    if (selectedIds.includes(id)) {
      setSelectedIds(selectedIds.filter(itemId => itemId !== id));
      setSelectAll(false);
    } else {
      const newSelected = [...selectedIds, id];
      setSelectedIds(newSelected);
      if (newSelected.length === data.length) {
        setSelectAll(true);
      }
    }
  };

  const getStatusBadge = (status: string, label: string) => {
    const statusColors: { [key: string]: string } = {
      "Dijadwalkan": "bg-[#EAB308] text-black", // Yellow/Gold
      "Klaim Selesai": "bg-[#10B981] text-secondary", // Green
      "Dibatalkan Otomatis": "bg-[#F97316] text-white", // Orange/Red
      "Verifikasi Principal": "bg-[#FACC15] text-black", // Yellow
      "Disetujui": "bg-green-500 text-secondary", // Fallback/Other
    };

    const colorClass = statusColors[label] || "bg-gray-500 text-white";

    return (
      <span className={`${colorClass} px-3 py-2 rounded-full font-bold text-xs whitespace-nowrap`}>
        {label}
      </span>
    );
  };

  return (
    <>
      <LoadingOverlay show={loading} />
      <div className="w-full flex flex-col gap-5 p-5 text-sm xl:text-base">
        {/* Header */}
        <div className="flex flex-col gap-5">
          <div className="text-white font-bold text-lg xl:text-xl">
            <p>Klaim Garansi / Master Data</p>
          </div>

          {/* Statistics Cards */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            {/* Card 1 - Total Permintaan Klaim Garansi */}
            <div className="box-container flex flex-col gap-3">
              <div className="flex items-start justify-between">
                <div className="bg-primary p-3 rounded-lg">
                  <IoCalendarOutline className="text-secondary text-xl" />
                </div>
                <div className="flex items-center gap-2">
                  <select 
                    value={timeFilter}
                    onChange={(e) => setTimeFilter(e.target.value)}
                    className="bg-transparent text-text-secondary text-xs border-none outline-none cursor-pointer"
                  >
                    <option value="30 Hari Terakhir">30 Hari Terakhir</option>
                    <option value="Hari Ini">Hari Ini</option>
                  </select>
                </div>
              </div>
              <div>
                <p className="text-text-secondary text-xs mb-1">Total Permintaan Klaim Garansi</p>
                <div className="flex items-end gap-2">
                  <p className="text-white text-3xl font-bold">{stats?.total_last_30_days ?? 0}</p>
                  {stats?.total_last_30_days_percentage !== undefined && (
                    <span className={`text-xs px-2 py-1 rounded ${stats.total_last_30_days_percentage >= 0 ? 'bg-red-500/20 text-red-500' : 'bg-red-500/20 text-red-500'}`}>
                       {/* Note: Image shows -12% as Red/Orange background. Usually negative is red, but here it might be context dependent. I'll stick to red for negative */}
                      {stats.total_last_30_days_percentage >= 0 ? '↑' : '↓'} {Math.abs(stats.total_last_30_days_percentage)}%
                    </span>
                  )}
                </div>
              </div>
            </div>

            {/* Card 2 - Permintaan Belum Terverifikasi */}
            <div className="box-container flex flex-col gap-3">
              <div className="flex items-start justify-between">
                <div className="bg-primary p-3 rounded-lg">
                  <IoDocumentTextOutline className="text-secondary text-xl" />
                </div>
                <div className="flex items-center gap-2">
                  <p className="text-text-secondary text-xs">Hari Ini</p>
                </div>
              </div>
              <div>
                <p className="text-text-secondary text-xs mb-1">Permintaan Belum Terverifikasi</p>
                <div className="flex items-end gap-2">
                  <p className="text-white text-3xl font-bold">{stats?.pending_verification ?? 0}</p>
                   {/* Image doesn't show percentage here, so I'll keep it cleaner or match previous logic if needed. */}
                </div>
              </div>
            </div>

            {/* Card 3 - Total Klaim Garansi Selesai */}
            <div className="box-container flex flex-col gap-3">
              <div className="flex items-start justify-between">
                <div className="bg-primary p-3 rounded-lg">
                  <BsCheckCircle className="text-secondary text-xl" />
                </div>
                <div className="flex items-center gap-2">
                  <p className="text-text-secondary text-xs">30 Hari Terakhir</p>
                </div>
              </div>
              <div>
                <p className="text-text-secondary text-xs mb-1">Total Klaim Garansi Selesai</p>
                <div className="flex items-end gap-2">
                  <p className="text-white text-3xl font-bold">{stats?.completed ?? 0}</p>
                  {stats?.completed_percentage !== undefined && (
                    <span className={`text-xs px-2 py-1 rounded ${stats.completed_percentage >= 0 ? 'bg-green-500/20 text-green-500' : 'bg-red-500/20 text-red-500'}`}>
                      {stats.completed_percentage >= 0 ? '↑' : '↓'} {Math.abs(stats.completed_percentage)}%
                    </span>
                  )}
                </div>
              </div>
            </div>

            {/* Card 4 - Total Klaim Garansi Diterima */}
            <div className="box-container flex flex-col gap-3">
              <div className="flex items-start justify-between">
                <div className="bg-primary p-3 rounded-lg">
                  <BsFileText className="text-secondary text-xl" />
                </div>
                <div className="flex items-center gap-2">
                  <p className="text-text-secondary text-xs">Hari Ini</p>
                </div>
              </div>
              <div>
                <p className="text-text-secondary text-xs mb-1">Total Klaim Garansi Diterima</p>
                <p className="text-white text-3xl font-bold">{stats?.received ?? 0}</p>
              </div>
            </div>
          </div>

          {/* Data Section */}
          <div className="flex flex-col gap-3">
            <div>
              <p className="text-white font-bold text-lg">Data Klaim Garansi</p>
              <p className="text-text-secondary text-sm">Menampilkan keseluruhan Data Klaim Garansi</p>
            </div>

            <div className="box-container flex flex-col gap-5">
              {/* Search and Export */}
              <div className="flex flex-col md:flex-row gap-5 justify-between">
                <div className="relative w-full md:w-70">
                  <input
                    placeholder="Cari Berdasarkan ID Warranty"
                    value={searchInput}
                    onChange={(e) => setSearchInput(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === "Enter") {
                        setPage(1);
                        setSearch(searchInput);
                      }
                    }}
                    className="bg-input py-3 pl-3 pr-10 rounded-lg border border-input-border text-white w-full"
                  />

                  <button
                    type="button"
                    onClick={() => {
                      setPage(1);
                      setSearch(searchInput);
                    }}
                    className="absolute right-3 top-1/2 -translate-y-1/2 text-input-border text-xl hover:text-white transition"
                  >
                    <CiSearch />
                  </button>
                </div>
                <button
                  onClick={handleExport}
                  className="bg-primary rounded-lg py-3 px-5 text-secondary font-bold flex justify-center items-center gap-2 cursor-pointer whitespace-nowrap"
                >
                  <FiDownload />
                  Export Data
                </button>
              </div>

              {/* Table */}
              <div className="overflow-x-auto rounded-lg w-full text-xs xl:text-sm">
                <table className="table-auto text-left text-white w-full">
                  <thead className="bg-[#333333] text-sm">
                    <tr>
                      <th className="px-5 py-4">
                        <input 
                          type="checkbox" 
                          className="w-4 h-4" 
                          checked={selectAll}
                          onChange={handleSelectAll}
                        />
                      </th>
                      <th className="px-5 py-4 whitespace-nowrap">
                        ID Klaim Garansi ↑
                      </th>
                      <th className="px-5 py-4 whitespace-nowrap">ID Warranty ↑</th>
                      <th className="px-5 py-4 whitespace-nowrap">
                        Nama Lengkap ↑
                      </th>
                      <th className="px-5 py-4 whitespace-nowrap">
                        Plat Kendaraan ↑
                      </th>
                      <th className="px-5 py-4 whitespace-nowrap">Odometer ↑</th>
                      <th className="px-5 py-4 whitespace-nowrap flex items-center">
                        Status ≡
                      </th>
                      <th className="px-5 py-4"></th>
                    </tr>
                  </thead>

                  <tbody>
                    {loading ? (
                      <tr>
                        <td colSpan={8} className="text-center py-6">
                          Loading...
                        </td>
                      </tr>
                    ) : data.length === 0 ? (
                      <tr>
                        <td colSpan={8} className="text-center py-6">
                          Data tidak ditemukan
                        </td>
                      </tr>
                    ) : (
                      data.map((item) => (
                        <tr
                          key={item.id}
                          className="bg-background text-text-secondary hover:bg-opacity-80 transition"
                        >
                          <td className="px-5 py-4">
                            <input 
                              type="checkbox" 
                              className="w-4 h-4" 
                              checked={selectedIds.includes(item.id)}
                              onChange={() => handleSelectItem(item.id)}
                            />
                          </td>
                          <td className="px-5 py-4">
                            {item?.claim_submission_code ?? "-"}
                          </td>
                          <td className="px-5 py-4 text-primary font-semibold">
                            {item?.warranty_code ?? "-"}
                          </td>
                          <td className="px-5 py-4">
                            {item?.name ?? "-"}
                          </td>
                          <td className="px-5 py-4">
                            {item?.plate_number ?? "-"}
                          </td>
                          <td className="px-5 py-4">{item?.odometer ?? 0} km</td>
                          <td className="px-5 py-4 whitespace-nowrap">
                            {getStatusBadge(item.status, item.status_label)}
                          </td>
                          <td className="py-3 text-primary font-semibold cursor-pointer whitespace-nowrap pr-5">
                            <Link
                              href={`/admin/dashboard/klaim-garansi/pengajuan/${item.id}`}
                              className="flex items-center gap-2"
                            >
                              Lihat Detail
                              <MdOutlineRemoveRedEye />
                            </Link>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>

              {/* Pagination */}
              <Pagination
                page={page}
                totalPages={totalPages}
                perPage={perPage}
                setPage={setPage}
                setPerPage={setPerPage}
                getPagination={getPagination}
                pagination={pagination}
                label="data Master Data"
              />
            </div>
          </div>
        </div>
      </div>
    </>
  );
}
