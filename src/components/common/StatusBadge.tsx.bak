"use client";

interface StatusBadgeProps {
  label: string;
  variant: 
    | "pending" 
    | "rejectAdmin" 
    | "approveAdmin" 
    | "stockReady" 
    | "stockEmpty" 
    | "apptReq" 
    | "scheduled" 
    | "completed" 
    | "rejectStore";
  showIcon?: boolean;
  tooltip?: string;
}

const VARIANT_STYLES: Record<StatusBadgeProps["variant"], string> = {
  pending: "bg-[#EAB308] text-black",
  rejectAdmin: "bg-[#EF4444] text-white",
  approveAdmin: "bg-[#10B981] text-secondary",
  stockReady: "bg-[#10B981] text-secondary",
  stockEmpty: "bg-[#EF4444] text-white",
  apptReq: "bg-[#EAB308] text-black",
  scheduled: "bg-[#EAB308] text-black",
  completed: "bg-[#10B981] text-secondary",
  rejectStore: "bg-[#EF4444] text-white",
};

export default function StatusBadge({
  label,
  variant,
  showIcon = true,
  tooltip,
}: StatusBadgeProps) {
  return (
    <div className="relative inline-flex items-center gap-2">
      <div
        className={`
          px-3 py-2
          rounded-full
          text-xs xl:text-sm
          flex items-center gap-2
          font-medium
          ${VARIANT_STYLES[variant]}
        `}
      >
        <span>{label}</span>
        {showIcon && (
          <div className="relative group">
            <button type="button" aria-label="Info">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
              >
                <path
                  d="M7.33398 6.00001H8.66732V4.66668H7.33398M8.00065 13.3333C5.06065 13.3333 2.66732 10.94 2.66732 8.00001C2.66732 5.06001 5.06065 2.66668 8.00065 2.66668C10.9406 2.66668 13.334 5.06001 13.334 8.00001C13.334 10.94 10.9406 13.3333 8.00065 13.3333ZM8.00065 1.33334C7.12517 1.33334 6.25827 1.50578 5.44943 1.84081C4.64059 2.17584 3.90566 2.66691 3.28661 3.28596C2.03636 4.53621 1.33398 6.2319 1.33398 8.00001C1.33398 9.76812 2.03636 11.4638 3.28661 12.7141C3.90566 13.3331 4.64059 13.8242 5.44943 14.1592C6.25827 14.4942 7.12517 14.6667 8.00065 14.6667C9.76876 14.6667 11.4645 13.9643 12.7147 12.7141C13.9649 11.4638 14.6673 9.76812 14.6673 8.00001C14.6673 7.12453 14.4949 6.25762 14.1598 5.44879C13.8248 4.63995 13.3338 3.90502 12.7147 3.28596C12.0956 2.66691 11.3607 2.17584 10.5519 1.84081C9.74304 1.50578 8.87613 1.33334 8.00065 1.33334ZM7.33398 11.3333H8.66732V7.33334H7.33398V11.3333Z"
                  fill="currentColor"
                />
              </svg>
            </button>
            {tooltip && (
              <div
                className="
                  absolute
                  bottom-full
                  left-1/2
                  -translate-x-1/2
                  mb-5
                  px-3 py-2
                  rounded-lg
                  text-xs
                  text-secondary
                  bg-primary
                  whitespace-nowrap
                  opacity-0
                  scale-95
                  pointer-events-none
                  transition-all duration-200
                  group-hover:opacity-100
                  group-hover:scale-100
                  z-50
                "
              >
                {tooltip}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
